    local mainFrame = screenGui:FindFirstChild("CandyFarm") and screenGui.CandyFarm:FindFirstChildOfClass("Frame")
    if not mainFrame then
        ensureGUI()
        return
    end
    
    -- Обновляем позицию если вышла за пределы экрана
    mainFrame.Position = clampPosition(mainFrame.Position, mainFrame.Size)
    
    -- Обновляем состояние кнопки
    local contentFrame = mainFrame:FindFirstChild("ContentFrame")
    if contentFrame then
        local toggleButton = contentFrame:FindFirstChildOfClass("TextButton")
        local statusLabel = contentFrame:FindFirstChild("StatusLabel")
        
        if toggleButton and statusLabel then
            if isEnabled then
                toggleButton.Text = "⏹ Stop"
                statusLabel.Text = "✅ ON"
                statusLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
            else
                toggleButton.Text = "▶ Start"
                statusLabel.Text = "❌ OFF"
                statusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
            end
        end
    end
end

