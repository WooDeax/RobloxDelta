local function checkForNewHouses()
    cleanupVisitedHouses() -- Очищаем дома которые пропали
    
    local allHouses = findAllHousesInOrder()
    local newHouses = {}
    local currentTime = tick()
    
    for _, houseData in ipairs(allHouses) do
        local lastVisit = lastVisitTimes[houseData.houseName]
        -- Если дом новый ИЛИ прошло больше 15 секунд с последнего посещения
        if not lastVisit or (currentTime - lastVisit) > SETTINGS.REVISIT_TIME then
            table.insert(newHouses, houseData)
        end
    end
    
    return newHouses
end

local function teleportToNewHouses()
    if not isEnabled or isTeleporting then return end
    
    isTeleporting = true

    local newHouses = checkForNewHouses()
    
    if #newHouses == 0 then
        isTeleporting = false
        return
    end

    local character = player.Character
    if not character then 
        isTeleporting = false
        return 
    end

    local humanoid = character:FindFirstChild("Humanoid")
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not humanoid or not rootPart or humanoid.Health <= 0 then 
        isTeleporting = false
        return 
    end

    if not startPosition then
        startPosition = rootPart.CFrame
    end

    -- Телепорт к домам
    for i, houseData in ipairs(newHouses) do
        if not isEnabled then 
            break 
        end

        rootPart.CFrame = houseData.doorPart.CFrame
        visitedHouses[houseData.houseName] = true
        lastVisitTimes[houseData.houseName] = tick()
        
        if houseInfoLabel then
            houseInfoLabel.Text = "🍭 " .. i .. "/" .. #newHouses
        end

        wait(SETTINGS.WAIT_BETWEEN_DOORS)
    end

    -- Возвращаемся только если есть дома для посещения
    if #newHouses > 0 and isEnabled and character and character:FindFirstChild("HumanoidRootPart") then
        if houseInfoLabel then
            houseInfoLabel.Text = "↩ Return"
        end
        wait(0.5)
        rootPart.CFrame = startPosition
    end
    
    isTeleporting = false
end

function startMainLoop()
    if mainLoopConnection then
        mainLoopConnection:Disconnect()
    end

    mainLoopConnection = RunService.Heartbeat:Connect(function()
        if not isEnabled then 
            if mainLoopConnection then
                mainLoopConnection:Disconnect()
                mainLoopConnection = nil
            end
            return 
        end
        
        if isTeleporting then return end
        if not player.Character then return end

        spawn(function()
            teleportToNewHouses()
        end)
    end)
end

function stopMainLoop()
    if mainLoopConnection then
        mainLoopConnection:Disconnect()
        mainLoopConnection = nil
    end
    isTeleporting = false
    isEnabled = false
    startPosition = nil

    if houseInfoLabel then
        local allHouses = findAllHousesInOrder()
        houseInfoLabel.Text = "🏠 " .. #allHouses .. " Houses"
    end
end

-- Функции для обновления управления
function startControlUpdates()
    if controlUpdateConnection then
        controlUpdateConnection:Disconnect()
    end
    
    controlUpdateConnection = RunService.Heartbeat:Connect(function()
        if not scriptActive then
            stopControlUpdates()
            return
        end
    end)
    
    -- Запускаем периодическое обновление каждые 2 секунды
    spawn(function()
        while scriptActive do
            updateGUIControls()
            wait(SETTINGS.CONTROL_UPDATE_INTERVAL)
        end
    end)
end

function stopControlUpdates()
    if controlUpdateConnection then
        controlUpdateConnection:Disconnect()
        controlUpdateConnection = nil
    end
end

