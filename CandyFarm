		infoLabel.Font = Enum.Font.Gotham
		infoLabel.Parent = contentFrame
		houseInfoLabel = infoLabel

		local dragging = false
		local dragInput, dragStart, startPos

		local function update(input)
			local delta = input.Position - dragStart
			local newPosition = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
			mainFrame.Position = clampPosition(newPosition, mainFrame.Size)
		end

		topBar.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
				dragging = true
				dragStart = input.Position
				startPos = mainFrame.Position

				input.Changed:Connect(function()
					if input.UserInputState == Enum.UserInputState.End then
						dragging = false
					end
				end)
			end
		end)

		topBar.InputChanged:Connect(function(input)
			if (input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseMovement) and dragging then
				dragInput = input
			end
		end)

		UserInputService.InputChanged:Connect(function(input)
			if input == dragInput and dragging then
				update(input)
			end
		end)

		local function updateButtonAppearance()
			if isEnabled then
				toggleButton.Text = "⏹ Stop"
				statusLabel.Text = "✅ ON"
				statusLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
			else
				toggleButton.Text = "▶ Start"
				statusLabel.Text = "❌ OFF"
				statusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
			end
		end

		local function handleToggle()
			local currentTime = tick()
			if currentTime - lastToggleTime < TOGGLE_COOLDOWN then
				return
			end
			
			lastToggleTime = currentTime
			animateButtonClick(toggleButton)
			
			isEnabled = not isEnabled
			updateButtonAppearance()

			if isEnabled then
				startMainLoop()
			else
				stopMainLoop()
			end
		end

		toggleButton.MouseButton1Click:Connect(handleToggle)
		toggleButton.TouchTap:Connect(handleToggle)

		minimizeBtn.MouseButton1Click:Connect(function()
			isMinimized = not isMinimized
			contentFrame.Visible = not isMinimized
			if isMinimized then
				mainFrame.Size = UDim2.new(0, 200, 0, 25)
				minimizeBtn.Text = "＋"
			else
				mainFrame.Size = UDim2.new(0, 200, 0, 120)
				minimizeBtn.Text = "─"
			end
			mainFrame.Position = clampPosition(mainFrame.Position, mainFrame.Size)
		end)

		closeBtn.MouseButton1Click:Connect(function()
			scriptActive = false
			stopMainLoop()
			if screenGui then
				screenGui:Destroy()
				screenGui = nil
			end
		end)

		updateButtonAppearance()
		updateHouseCount()
	end
	return screenGui
end

local function teleportToAllHousesInOrder()
	if not isEnabled or isTeleporting then return end
	
	isTeleporting = true

	local allHouses = findAllHousesInOrder()
	
	if #allHouses == 0 then
		if houseInfoLabel then
			houseInfoLabel.Text = "🏠 0 Houses"
		end
		isTeleporting = false
		return
	end

	local character = player.Character
	if not character then 
		isTeleporting = false
		return 
	end

	local humanoid = character:FindFirstChild("Humanoid")
	local rootPart = character:FindFirstChild("HumanoidRootPart")
	if not humanoid or not rootPart or humanoid.Health <= 0 then 
		isTeleporting = false
		return 
	end

	enableNoClip(character)

	if houseInfoLabel then
		houseInfoLabel.Text = "🏠 " .. #allHouses .. " Houses"
	end

	for i, houseData in ipairs(allHouses) do
		if not isEnabled then 
			isTeleporting = false
			break 
		end

		rootPart.CFrame = houseData.doorPart.CFrame
		
		if houseInfoLabel then
			houseInfoLabel.Text = "🏠 " .. i .. "/" .. #allHouses
		end

		if i < #allHouses then
			wait(SETTINGS.WAIT_BETWEEN_DOORS)
		end
	end

	if isEnabled then
		if houseInfoLabel then
			houseInfoLabel.Text = "✅ Done"
		end
		
		wait(SETTINGS.WAIT_BEFORE_DEATH)
		
		if character and character:FindFirstChild("HumanoidRootPart") then
			teleportUnderMap(character)
			if houseInfoLabel then
				houseInfoLabel.Text = "⬇️ Down"
			end
		end
	end
	
	isTeleporting = false
end

function startMainLoop()
	if mainLoopConnection then
		mainLoopConnection:Disconnect()
	end

	mainLoopConnection = RunService.Heartbeat:Connect(function()
		if not isEnabled then 
			if mainLoopConnection then
				mainLoopConnection:Disconnect()
				mainLoopConnection = nil
			end
			return 
		end
		
		if isTeleporting then return end
		if not player.Character then return end

		local humanoid = player.Character:FindFirstChild("Humanoid")
		local rootPart = player.Character:FindFirstChild("HumanoidRootPart")
		if not humanoid or not rootPart or humanoid.Health <= 0 then return end

		spawn(function()
			teleportToAllHousesInOrder()
		end)

		wait(2)
	end)
end

function stopMainLoop()
	if mainLoopConnection then
		mainLoopConnection:Disconnect()
		mainLoopConnection = nil
	end
	isTeleporting = false
	isEnabled = false

	if houseInfoLabel then
		local allHouses = findAllHousesInOrder()
		houseInfoLabel.Text = "🏠 " .. #allHouses .. " Houses"
	end
end

