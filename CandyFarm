local function enableNoClip(character)
	if character then
		local humanoid = character:FindFirstChild("Humanoid")
		if humanoid then
			humanoid:ChangeState(11)
		end
	end
end

local function teleportUnderMap(character)
	if character then
		local rootPart = character:FindFirstChild("HumanoidRootPart")
		if rootPart then
			local newPosition = Vector3.new(0, -5000, 0)
			rootPart.CFrame = CFrame.new(newPosition)
		end
	end
end

local function clampPosition(position, size)
	local viewportSize = workspace.CurrentCamera.ViewportSize
	local x = math.clamp(position.X.Offset, 10, viewportSize.X - size.X.Offset - 10)
	local y = math.clamp(position.Y.Offset, 10, viewportSize.Y - size.Y.Offset - 10)
	return UDim2.new(0, x, 0, y)
end

local function animateButtonClick(button)
	local originalColor = button.BackgroundColor3
	local originalSize = button.Size
	
	local tweenIn = TweenService:Create(button, TweenInfo.new(0.1), {
		BackgroundColor3 = Color3.fromRGB(20, 20, 30),
		Size = UDim2.new(originalSize.X.Scale, originalSize.X.Offset - 2, originalSize.Y.Scale, originalSize.Y.Offset - 2)
	})
	tweenIn:Play()
	
	spawn(function()
		wait(0.2)
		local tweenOut = TweenService:Create(button, TweenInfo.new(0.1), {
			BackgroundColor3 = originalColor,
			Size = originalSize
		})
		tweenOut:Play()
	end)
end

local function findAllHousesInOrder()
	local allHouses = {}
	
	local houses = workspace:FindFirstChild("Houses")
	if not houses then
		return allHouses
	end

	for _, house in pairs(houses:GetChildren()) do
		local doorModel = house:FindFirstChild("Door")
		if doorModel and doorModel:IsA("Model") then
			local doorPart = doorModel.PrimaryPart
			if not doorPart then
				for _, part in pairs(doorModel:GetChildren()) do
					if part:IsA("BasePart") then
						doorPart = part
						break
					end
				end
			end
			
			if doorPart then
				table.insert(allHouses, {
					house = house,
					doorPart = doorPart,
					houseName = house.Name
				})
			end
		end
	end

	return allHouses
end

local function updateHouseCount()
	local allHouses = findAllHousesInOrder()
	currentHouseCount = #allHouses
	
	if houseInfoLabel and houseInfoLabel.Parent then
		houseInfoLabel.Text = "🏠 " .. currentHouseCount .. " Houses"
	end
	
	return currentHouseCount
end

